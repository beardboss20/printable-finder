# Required for photo recognition and visual ranking.
XAI_API_KEY=
# Optional model override. Defaults to grok-4.6 (retries once with grok-4.5).
# XAI_MODEL=
# Optional. Enables Thingiverse search. Other sites still run when this is unset.
# THINGIVERSE_TOKEN=
# Optional — only if you enable accounts
# BETTER_AUTH_SECRET=
# DATABASE_URL=
